{
  "topic": "retry-decision",
  "protocol": "3.0.0-alpha.6",
  "rules": [
    "P4.6",
    "P4.7"
  ],
  "description": "一次尝试失败后是否再试。没有 kind 的项：给出方法是否幂等、这次的结果、已做的尝试次数（含刚失败的这次）、预算是否允许、退避之后的剩余毫秒，期望 retry 或 stop。kind=backoff：失败 n 次后退避的上限（实际退避在 [0, 上限] 内随机）。",
  "fields": {
    "idempotent": "契约是否声明无副作用或幂等",
    "outcome": "这次尝试的结果（gRPC 码名，或 CONNECT_FAILED_BEFORE_SEND）",
    "attempts_made": "已做的尝试次数",
    "budget_allows": "重试预算是否允许（P4.8）",
    "remaining_ms_after_backoff": "退避之后的剩余毫秒，null 为没有",
    "expect": "retry | stop",
    "failed_attempts": "已失败的次数",
    "max_backoff_ms": "退避上限"
  },
  "cases": [
