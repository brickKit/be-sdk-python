{
  "topic": "watermark-source-state",
  "protocol": "3.0.0-alpha.68",
  "rules": [
    "P9.26"
  ],
  "description": "一个来源的对齐状态怎样迁移（装配项目协议 02 的对齐状态表，去掉第 12 步的几行）：current 是状态（aligned、aligning、stalled、blocked）、confirmed（blocked 的“已确认”）、rollback（对齐的起因有回退）、stalled_gen 与 blocked_gen（进入时的部署恢复代次）、prior（进入 blocked 前的状态）；event 是 first_contact、adopt_epoch（采用更大的纪元）、beyond_retention、rollback（绊线，或主库的系统标识不同而代次不更大）、foreign（没有登记的实现实例或别的部署）、operator_confirms、primary_response（matches：属于已采用的实例与部署、系统标识相同或不同而代次更大；row_check：保存的连续位置上的行核对）、alignment_done、environment_copy，gen 是输入声明的部署恢复代次；expect 是之后的这些字段与动作。",
  "fields": {
    "current": "来源此刻的状态",
    "event": "输入",
    "expect": "之后的状态与动作"
  },
  "cases": [
    {
      "id": "first-contact",
      "current": {
        "state": "aligning"
      },
      "event": {
        "kind": "first_contact",
        "gen": 3
      },
      "expect": {
        "state": "aligning",
        "confirmed": false,
        "rollback": false,
        "stalled_gen": null,
        "blocked_gen": null,
        "prior": null,
        "action": "refetch"
      }
    },
    {
