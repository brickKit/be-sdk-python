        "now": "2026-11-05T12:00:00.000000Z"
      },
      "expected": {
        "state": "sending",
        "reason": "the external system deduplicates and the deadline has not passed"
      },
      "description": "EI04: not found, the external system deduplicates: same reference"
    },
