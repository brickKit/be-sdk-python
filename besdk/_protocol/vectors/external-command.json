{
  "topic": "external-command",
  "protocol": "3.0.0-alpha.117",
  "rules": [
    "P13.2",
    "P13.3",
    "P13.4",
    "P13.5",
    "P13.6",
    "P13.7",
    "P13.8"
  ],
  "description": "对外命令：状态转移（按行序第一条命中）、查询“不存在”之后是否重发、重发截止时刻的公式、请求按参考号与参数摘要的幂等",
  "fields": {
    "input": "command, event, capabilities, now | command, capabilities | stored, incoming",
    "expected": "state, reason | resend_deadline | digest, answer"
  },
  "cases": [
    {
      "id": "ei01-read-timeout",
      "input": {
        "command": {
          "state": "sending"
        },
        "event": {
          "kind": "send_result",
          "result": "maybe_reached"
        },
        "capabilities": {
          "query": true
        },
        "now": "2026-11-05T10:00:00.000000Z"
      },
      "expected": {
        "state": "unknown",
        "reason": "may have been processed: query first"
      },
      "description": "EI01: a read timeout is unknown, queried first"
    },
    {
      "id": "connection-failed",
      "input": {
        "command": {
          "state": "sending"
        },
        "event": {
          "kind": "send_result",
          "result": "not_reached"
        },
        "capabilities": {
          "query": true
        },
        "now": "2026-11-05T10:00:00.000000Z"
      },
      "expected": {
        "state": "retry_wait",
        "reason": "certainly not processed: backoff and send again"
      }
    },
    {
      "id": "accepted",
      "input": {
        "command": {
          "state": "sending"
        },
        "event": {
          "kind": "send_result",
          "result": "accepted"
        },
        "capabilities": {
          "query": true
        },
        "now": "2026-11-05T10:00:00.000000Z"
      },
      "expected": {
        "state": "accepted",
        "reason": "accepted, not final"
      },
      "description": "EI12: accepted is not paid"
    },
    {
      "id": "rejected",
      "input": {
        "command": {
          "state": "sending"
        },
        "event": {
          "kind": "send_result",
          "result": "rejected"
        },
        "capabilities": {
          "query": true
        },
        "now": "2026-11-05T10:00:00.000000Z"
      },
      "expected": {
        "state": "rejected",
        "reason": "refused for good"
      }
    },
    {
      "id": "ei02-query-unavailable",
      "input": {
        "command": {
          "state": "unknown",
          "first_reached_at": "2026-11-05T10:00:00.000000Z",
          "last_reached_at": "2026-11-05T10:00:00.000000Z",
          "unknown_since": "2026-11-05T10:00:00.000000Z"
        },
        "event": {
          "kind": "query",
          "result": "unavailable"
        },
        "capabilities": {
          "query": true
        },
        "now": "2026-11-05T11:00:00.000000Z"
      },
      "expected": {
        "state": "unknown",
        "reason": "the query is unavailable: backoff"
      },
      "description": "EI02: the query unavailable: backoff"
    },
    {
      "id": "ei02-past-the-manual-limit",
      "input": {
        "command": {
          "state": "unknown",
          "first_reached_at": "2026-11-05T10:00:00.000000Z",
          "last_reached_at": "2026-11-05T10:00:00.000000Z",
          "unknown_since": "2026-11-05T10:00:00.000000Z"
        },
        "event": {
          "kind": "query",
          "result": "unavailable"
