      "input": {
        "command": {
          "state": "unknown",
          "first_reached_at": "2026-11-05T10:00:00.000000Z",
          "last_reached_at": "2026-11-05T10:00:00.000000Z",
          "unknown_since": "2026-11-05T10:00:00.000000Z"
        },
        "event": {
          "kind": "query",
          "result": "not_found"
        },
        "capabilities": {
          "query": true
        },
        "now": "2026-11-05T10:05:00.000000Z"
      },
      "expected": {
        "state": "manual",
        "reason": "the earlier request may still land"
      },
      "description": "EI03: not found, no dedupe, no expiry, no longest processing time"
