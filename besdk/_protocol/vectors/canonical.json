      "major": 1,
      "expect": {
        "out": "sha256:5331bbdda53d29ed099ef0339b240d946847ec90d10d35c531310ad35bee7c7e"
      }
    },
    {
      "id": "digest-same-json-other-major",
      "kind": "digest",
      "in": {
        "type": "demo.order",
        "fields": [
          "cost",
          "number"
        ]
      },
      "record_type": "be.security.resource_definition",
      "major": 2,
      "expect": {
        "out": "sha256:3781123784e5d270092f59ecaf38c86b34aec57da8c54db202fb97055cbb91d5"
      }
    },
    {
