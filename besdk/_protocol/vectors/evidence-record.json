{
  "topic": "evidence-record",
  "protocol": "3.0.0-alpha.117",
  "rules": [
    "P12.9",
    "P12.10"
  ],
  "description": "证据记录：类别的取值、规范摘要（前缀 be.evidence.record.v1），证据存储按（id，phase）的回答：已收下、重复、冲突",
  "fields": {
    "input": "record | stored, incoming",
    "expected": "categories | digest | answer"
  },
  "cases": [
    {
      "id": "categories",
      "expected": {
        "categories": [
          "security_tightening",
          "security_widening",
          "employment_end",
          "org_tightening",
          "account_status",
          "account_reenable",
          "identity_signing_key_revocation",
          "credential_tightening",
          "credential_tightening_in_product",
          "session_revocation",
          "recovery_credential_rotation",
          "document_number",
          "member_switch_handover",
          "destruction",
          "erasure",
          "external_command_issued",
          "external_command_outcome",
          "deployment_generation",
          "authz_generation",
          "evidence_double_failure"
        ]
      }
    },
    {
      "id": "position-by-phase",
      "description": "only effective and general carry a position",
      "expected": {
        "with_position": [
          "effective",
          "general"
        ],
        "without_position": [
          "intent",
          "cancelled"
        ]
      }
    },
