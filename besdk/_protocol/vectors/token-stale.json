{
  "topic": "token-stale",
  "protocol": "3.0.0-alpha.56",
  "rules": [
    "P8.25"
  ],
  "description": "准入时的令牌陈旧判断。token_sv 是凭据的 be_sv；entry 是判定所用的视图分片里这个主体的条目（null 表示分片里没有这个主体，{} 表示条目没有 security_version 字段，二者都按 0）；stale 为真时答 TOKEN_STALE。",
  "fields": {
    "token_sv": "凭据的 be_sv",
    "entry": "视图分片里的主体条目",
    "expect": "stale"
  },
  "cases": [
    {
      "id": "equal",
      "token_sv": 3,
      "entry": {
        "security_version": 3
      },
      "expect": {
        "stale": false
      }
    },
    {
      "id": "token-newer",
      "token_sv": 4,
      "entry": {
        "security_version": 3
      },
      "expect": {
        "stale": false
      }
    },
    {
      "id": "view-newer",
      "token_sv": 3,
      "entry": {
        "security_version": 4
      },
      "expect": {
        "stale": true
      }
    },
    {
      "id": "view-much-newer",
      "token_sv": 1,
      "entry": {
        "security_version": 1099511627776
      },
      "expect": {
        "stale": true
      }
    },
    {
      "id": "subject-absent",
      "token_sv": 1,
      "entry": null,
      "expect": {
        "stale": false
      }
    },
    {
      "id": "field-absent",
      "token_sv": 1,
      "entry": {},
      "expect": {
        "stale": false
      }
    }
  ]
}
