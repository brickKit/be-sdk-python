        "forwarded": 0,
        "exchanges": 0,
        "renew_idle": null,
        "browser": "CSRF_HEADER_REQUIRED"
      }
    },
    {
      "id": "get-without-header",
      "method": "GET",
      "cookie": true,
      "headers": {},
      "body_bytes": 0,
