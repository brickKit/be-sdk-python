      "exchange": [],
      "answers": [],
      "expect": {
        "forwarded": 0,
        "exchanges": 0,
        "renew_idle": null,
        "browser": "CSRF_HEADER_REQUIRED"
      }
    },
    {
      "id": "delete-without-header",
