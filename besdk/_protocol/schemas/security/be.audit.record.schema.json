{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brickKit/be-protocol/schemas/security/be.audit.record.schema.json",
  "title": "be.audit.record",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id"
    },
    "occurred_at": {
      "$ref": "#/$defs/Instant"
    },
    "category": {
      "type": "string",
      "enum": [
        "business_change",
        "security_change",
        "sensitive_read",
        "delegated",
        "security_denial",
        "work_disposition"
      ]
    },
    "operation": {
      "$ref": "#/$defs/Key"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "denied",
        "failed"
      ]
    },
    "reason": {
      "$ref": "#/$defs/Text"
    },
    "actor": {
      "$ref": "#/$defs/Text"
    },
    "represented": {
      "$ref": "#/$defs/Text"
    },
    "target": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Key"
      },
      "additionalProperties": {}
    },
    "changes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Key"
      },
      "additionalProperties": {}
    },
    "request": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Key"
      },
      "additionalProperties": {}
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "occurred_at",
    "category",
    "operation",
    "outcome"
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "Key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "maxLength": 128
    },
    "Text": {
      "type": "string"
    }
  }
}
